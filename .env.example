# Shared
DEMO_MODE=true

# API (server only)
PORT=3001
HOST=127.0.0.1
# Comma-separated when local and production origins are both allowed.
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Used only by the server. Never expose this value through a VITE_ variable.
SUPABASE_SECRET_KEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Keep simulated until OAuth is configured and deliberately activated.
GMAIL_DELIVERY_MODE=simulated
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/v1/integrations/gmail/callback
GMAIL_OAUTH_SUCCESS_URL=http://localhost:5173
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Web (only public values may use VITE_)
VITE_API_URL=http://localhost:3001
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

